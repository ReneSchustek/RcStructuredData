# Einheitliche Zeilenenden (LF) für alle Textdateien, unabhängig vom Betriebssystem.
* text=auto eol=lf

# Binärdateien nie normalisieren.
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Messprojekt: läuft gegen eine Testinstanz, gehört in kein Ausrollpaket.
/benchmarks export-ignore
/phpbench.json export-ignore
