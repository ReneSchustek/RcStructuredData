{
    "name": "ruhrcoder/rc-structured-data",
    "description": "Shopware 6 Plugin — Schema Graph Builder: erzeugt auf Kategorie- und Landingpages einen zusammenhängenden JSON-LD-@graph (CollectionPage, BreadcrumbList, Organization, WebSite, FAQPage, VideoObject)",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "version": "2.15.0",
    "authors": [
        {
            "name": "Ruhrcoder (René Schustek)",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.0 || ~6.8.0",
        "shopware/storefront": "~6.7.0 || ~6.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.0",
        "shopwarelabs/phpstan-shopware": "^0.2"
    },
    "extra": {
        "shopware-plugin-class": "Ruhrcoder\\RcStructuredData\\RcStructuredData",
        "label": {
            "de-DE": "Strukturierte Daten",
            "en-GB": "Structured Data"
        },
        "description": {
            "de-DE": "Schema Graph Builder: erzeugt auf Kategorie- und Landingpages einen zusammenhängenden JSON-LD-@graph (CollectionPage, BreadcrumbList, Organization, WebSite, FAQPage, VideoObject).",
            "en-GB": "Schema graph builder: produces a single connected JSON-LD @graph on category and landing pages (CollectionPage, BreadcrumbList, Organization, WebSite, FAQPage, VideoObject)."
        },
        "manufacturerLink": {
            "de-DE": "https://ruhrcoder.de",
            "en-GB": "https://ruhrcoder.de"
        },
        "supportLink": {
            "de-DE": "https://ruhrcoder.de",
            "en-GB": "https://ruhrcoder.de"
        }
    },
    "autoload": {
        "psr-4": {
            "Ruhrcoder\\RcStructuredData\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruhrcoder\\RcStructuredData\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    }
}
