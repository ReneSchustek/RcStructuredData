<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!-- Kern: ID-Erzeugung, Kontext-Aufbau, Graph-Zusammenbau -->
        <service id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>

        <service id="Ruhrcoder\RcStructuredData\Schema\SchemaContextFactory">
            <argument type="service" id="Shopware\Core\Content\Seo\SeoUrlPlaceholderHandlerInterface"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\GraphBuilder">
            <argument type="tagged_iterator" tag="rc_schema.node_provider"/>
        </service>

        <!-- Knoten-Provider (graph pieces) — je Schema-Typ einer, per Tag eingesammelt -->
        <service id="Ruhrcoder\RcStructuredData\Schema\Node\OrganizationNodeProvider">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\WebSiteNodeProvider">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\LocalBusinessNodeProvider">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\BreadcrumbNodeProvider">
            <argument type="service" id="Shopware\Core\Content\Category\Service\CategoryBreadcrumbBuilder"/>
            <argument type="service" id="Shopware\Core\Content\Seo\SeoUrlPlaceholderHandlerInterface"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <!-- Sichtbare Bilder einer Erlebniswelt für `image` am Seitenknoten -->
        <service id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsImageCollector">
            <argument type="service" id="media.repository"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\CollectionPageNodeProvider">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\ContentPageDetector"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsImageCollector"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\WebPageNodeProvider">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\ContentPageDetector"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsImageCollector"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <!-- Mitarbeiter (Name und Funktion) aus den Personenkarten des Themes -->
        <service id="Ruhrcoder\RcStructuredData\Schema\Node\PersonNodeProvider">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\FaqPageNodeProvider">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\FaqCmsBlockExtractor"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\DefinedTermSetNodeProvider">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\DefinedTermsCmsBlockExtractor"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\DigitalDocumentNodeProvider">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\DocumentsCmsBlockExtractor"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\VideoObjectNodeProvider">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\YoutubeVideoExtractor"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Enrichment\VideoMetadataEnricher"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Node\ItemListNodeProvider">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\ProductListingExtractor"/>
            <argument type="service" id="Shopware\Core\Content\Seo\SeoUrlPlaceholderHandlerInterface"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <!-- BlogPosting: liest nur aus dem SchemaContext (keine Blog-Plugin-Kopplung) -->
        <service id="Ruhrcoder\RcStructuredData\Schema\Node\BlogPostingNodeProvider">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\IdFactory"/>
            <tag name="rc_schema.node_provider"/>
        </service>

        <!-- Optionale Video-Metadaten-Anreicherung über die YouTube-Data-API (nur bei gesetztem Key) -->
        <service id="Ruhrcoder\RcStructuredData\Schema\Enrichment\YoutubeApiMetadataEnricher">
            <argument type="service" id="http_client"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="logger"/>
        </service>
        <service
            id="Ruhrcoder\RcStructuredData\Schema\Enrichment\VideoMetadataEnricher"
            alias="Ruhrcoder\RcStructuredData\Schema\Enrichment\YoutubeApiMetadataEnricher"/>

        <!-- CMS-Block-Extraktion (Datenquelle für FAQ/Video aus sichtbaren Blöcken) -->
        <service id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>

        <service id="Ruhrcoder\RcStructuredData\Schema\Cms\ContentPageDetector">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>
        </service>
        <service id="Ruhrcoder\RcStructuredData\Schema\Extractor\FaqCmsBlockExtractor">
            <argument type="service" id="Shopware\Core\Framework\Util\HtmlSanitizer"/>
        </service>
        <service id="Ruhrcoder\RcStructuredData\Schema\Extractor\DefinedTermsCmsBlockExtractor">
            <argument type="service" id="Shopware\Core\Framework\Util\HtmlSanitizer"/>
        </service>
        <service id="Ruhrcoder\RcStructuredData\Schema\Extractor\DocumentsCmsBlockExtractor"/>
        <service id="Ruhrcoder\RcStructuredData\Schema\Extractor\YoutubeVideoExtractor"/>
        <service id="Ruhrcoder\RcStructuredData\Schema\Extractor\ProductListingExtractor"/>

        <!-- Vollständigkeits-Diagnose (Debug-Kommentar + Konsolenbefehl) -->
        <service id="Ruhrcoder\RcStructuredData\Schema\Diagnostics\CompletenessChecker"/>

        <service id="Ruhrcoder\RcStructuredData\Schema\Diagnostics\PageWarningChecker">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\YoutubeVideoExtractor"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Diagnostics\SchemaDiagnoser">
            <argument type="service" id="category.repository"/>
            <argument type="service" id="cms_page.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\SchemaContextFactory"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\GraphBuilder"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Diagnostics\CompletenessChecker"/>
            <argument type="service" id="landing_page.repository"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Diagnostics\PageWarningChecker"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Block\Documents\DocumentsSlotHydrator"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Command\DiagnoseCommand">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Diagnostics\SchemaDiagnoser"/>
            <tag name="console.command"/>
        </service>

        <!-- Admin-API-Endpunkt für die sichtbare Diagnose-Karte -->
        <service id="Ruhrcoder\RcStructuredData\Controller\SchemaDiagnoseController" public="true">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Diagnostics\SchemaDiagnoser"/>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- rc-faq CMS-Element: registriert den Element-Typ und liefert das Accordion -->
        <service id="Ruhrcoder\RcStructuredData\Block\Faq\DataResolver\FaqResolver">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\FaqCmsBlockExtractor"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <!-- rc-defined-terms CMS-Element: registriert den Element-Typ und liefert die Begriffsliste -->
        <service id="Ruhrcoder\RcStructuredData\Block\DefinedTerms\DataResolver\DefinedTermsResolver">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\DefinedTermsCmsBlockExtractor"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <!-- rc-documents CMS-Element: Nachweise als Dateien, sichtbar verlinkt und als DigitalDocument ausgezeichnet -->
        <service id="Ruhrcoder\RcStructuredData\Block\Documents\DataResolver\DocumentsResolver">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\DocumentsCmsBlockExtractor"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Block\Documents\DocumentsStructBuilder"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>
        <service id="Ruhrcoder\RcStructuredData\Block\Documents\DocumentsStructBuilder">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\DocumentsCmsBlockExtractor"/>
        </service>
        <!-- Dieselbe Auflösung für die Diagnose, die die Seite ohne Storefront lädt -->
        <service id="Ruhrcoder\RcStructuredData\Block\Documents\DocumentsSlotHydrator">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsSlotIterator"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Extractor\DocumentsCmsBlockExtractor"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Block\Documents\DocumentsStructBuilder"/>
            <argument type="service" id="media.repository"/>
        </service>

        <!-- Storefront-Anbindung: hängt den Graphen als Page-Extension an -->
        <service id="Ruhrcoder\RcStructuredData\Subscriber\SchemaGraphSubscriber">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\SchemaContextFactory"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\GraphBuilder"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Diagnostics\CompletenessChecker"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Beantwortet der Vorlage, ob der Kern WebSite und Organization schon selbst ausgibt -->
        <!-- Versanddetails für offers.shippingDetails.

             Der Preis kommt aus RcProductFeedShippingExtension, das ihn für den Warenstrom
             ohnehin vorberechnet. `on-invalid="null"`: Ohne dieses Plugin bleibt der Dienst leer,
             und die strukturierten Daten kommen ohne `shippingRate` aus. -->
        <service id="Ruhrcoder\RcStructuredData\Schema\Product\RcProductFeedShippingRate">
            <argument type="service"
                      id="Ruhrcoder\RcProductFeedShippingExtension\Service\ShippingCostCalculatorService"
                      on-invalid="null"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Schema\Product\ShippingDetailsProvider">
            <argument type="service" id="country.repository"/>
            <argument type="service" id="shipping_method.repository"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Product\RcProductFeedShippingRate"/>
        </service>

        <service id="Ruhrcoder\RcStructuredData\Twig\StructuredDataExtension">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Product\ShippingDetailsProvider"/>
            <tag name="twig.extension"/>
        </service>

        <!-- Bilder in der Sitemap: Namensraum im Wurzelelement, Bilder je Eintrag an den vier Lieferanten des Kerns. -->
        <service id="Ruhrcoder\RcStructuredData\Sitemap\SitemapImageNamespaceSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="Ruhrcoder\RcStructuredData\Sitemap\SitemapImageLoader">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="category.repository"/>
            <argument type="service" id="landing_page.repository"/>
            <argument type="service" id="media.repository"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\Cms\CmsImageCollector"/>
        </service>
        <service id="Ruhrcoder\RcStructuredData\Sitemap\ImageUrlProvider.product" class="Ruhrcoder\RcStructuredData\Sitemap\ImageUrlProvider" decorates="Shopware\Core\Content\Sitemap\Provider\ProductUrlProvider">
            <argument type="service" id=".inner"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Sitemap\SitemapImageLoader"/>
        </service>
        <service id="Ruhrcoder\RcStructuredData\Sitemap\ImageUrlProvider.category" class="Ruhrcoder\RcStructuredData\Sitemap\ImageUrlProvider" decorates="Shopware\Core\Content\Sitemap\Provider\CategoryUrlProvider">
            <argument type="service" id=".inner"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Sitemap\SitemapImageLoader"/>
        </service>
        <service id="Ruhrcoder\RcStructuredData\Sitemap\ImageUrlProvider.landing_page" class="Ruhrcoder\RcStructuredData\Sitemap\ImageUrlProvider" decorates="Shopware\Core\Content\Sitemap\Provider\LandingPageUrlProvider">
            <argument type="service" id=".inner"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Sitemap\SitemapImageLoader"/>
        </service>
        <service id="Ruhrcoder\RcStructuredData\Sitemap\ImageUrlProvider.home" class="Ruhrcoder\RcStructuredData\Sitemap\ImageUrlProvider" decorates="Shopware\Core\Content\Sitemap\Provider\HomeUrlProvider">
            <argument type="service" id=".inner"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Sitemap\SitemapImageLoader"/>
        </service>
    </services>
</container>
