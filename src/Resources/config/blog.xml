<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <!--
        Nur geladen, wenn WerklOpenBlogware installiert ist (Plugin::build() prüft class_exists).
        Der Subscriber referenziert Blog-Plugin-Typen und darf daher nicht bedingungslos registriert
        werden.
    -->
    <services>
        <service id="Ruhrcoder\RcStructuredData\Subscriber\BlogSchemaSubscriber">
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\SchemaContextFactory"/>
            <argument type="service" id="Ruhrcoder\RcStructuredData\Schema\GraphBuilder"/>
            <argument type="service" id="Shopware\Core\Content\Cms\SalesChannel\SalesChannelCmsPageLoader"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
