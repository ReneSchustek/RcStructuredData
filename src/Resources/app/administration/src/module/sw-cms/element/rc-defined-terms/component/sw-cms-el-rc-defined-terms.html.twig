{% block sw_cms_element_rc_defined_terms %}
    <div class="sw-cms-el-rc-defined-terms">
        <div class="sw-cms-el-rc-defined-terms__preview">
            <sw-icon name="regular-book" small></sw-icon>
            <span class="sw-cms-el-rc-defined-terms__label">
                {{ element.config.termSetName.value || $tc('sw-cms.elements.rc-defined-terms.label') }}
            </span>

            <ul v-if="element.config.terms.value && element.config.terms.value.length" class="sw-cms-el-rc-defined-terms__terms">
                <li v-for="(item, index) in element.config.terms.value" :key="index">
                    {{ item.term }}
                </li>
            </ul>
        </div>
    </div>
{% endblock %}
